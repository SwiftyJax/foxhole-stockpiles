{
  "config_version": 5,
  "api_server": {
    "cors_allow_origins": ["*"],
    "host": "0.0.0.0",
    "port": 8000
  },
  "scanner": {
    "database_path": "/app/data/foxhole_templates.h5",
    "tessdata_path": "/app/tessdata",
    "screenshots_folder": "/app/screenshots"
  },
  "logging": {
    "log_level": "INFO",
    "log_file": "/app/logs/foxhole-scanner.log"
  }
}
