{
  "config_version": 2,
  "api_server": {
    "cors_allow_origins": ["https://yourdomain.com", "https://app.yourdomain.com"],
    "host": "0.0.0.0",
    "port": 8000,
    "workers": 4
  },
  "api_auth": {
    "auth_type": "bearer",
    "auth_token": "your-secret-api-token-here"
  },
  "scanner": {
    "database_path": "/app/data/foxhole_templates.h5",
    "tessdata_path": "/app/tessdata",
    "screenshots_folder": "/app/screenshots",
    "debug_mode": false
  },
  "output": {
    "format": "json",
    "destination": "webhook",
    "file": {
      "path": "output.json"
    },
    "webhook": {
      "url": "https://api.yourdomain.com/stockpiles",
      "auth_type": "bearer",
      "token": "your-webhook-secret-token-here",
      "client_auth_header": null
    },
    "console": {}
  },
  "logging": {
    "log_level": "INFO",
    "log_format": "[%(asctime)s] %(levelname)s [%(name)s] %(message)s",
    "date_format": "%Y-%m-%d %H:%M:%S",
    "rotate_logs": true,
    "log_file": "/app/logs/foxhole-api.log",
    "loggers": {
      "foxhole_stockpiles": "INFO",
      "uvicorn": "WARNING"
    }
  }
}
