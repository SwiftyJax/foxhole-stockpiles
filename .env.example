# Foxhole Stockpiles Docker Configuration
# Copy this file to .env and customize the values

# REQUIRED: Path to the template database file on your host machine
# This directory will be mounted to /data inside the container
FS_DATA_DIR=./data

# REQUIRED: Path to the database file inside the container
# Make sure this file exists in FS_DATA_DIR
FS_DATABASE_PATH=/data/foxhole_templates.h5

# Scanner Configuration (optional - defaults shown)
# Higher early exit threshold = stop matching sooner when confident
# (pHash, NCC-candidate, and tiebreaker thresholds are no longer
#  user-configurable as of config v8 - they use fixed defaults)
FS_SCANNER__EARLY_EXIT_THRESHOLD=0.95
FS_SCANNER__TEMPLATE_CACHE_SIZE=16

# Optional: API authentication token (for production)
# API_TOKEN=your-secret-token-here
